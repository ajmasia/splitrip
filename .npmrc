# Tags are plain semver, with no leading "v".
tag-version-prefix=""

# `npm version` must produce a Conventional Commit like every other commit,
# otherwise the commit-msg hook rejects the release it just made.
message="chore(release): %s"

# Refuse to install on an unsupported Node version. Without this, `engines` is
# advisory and a wrong version fails later, in a confusing place.
engine-strict=true
