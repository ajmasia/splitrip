# The gateway in front of Supabase's services, in place of the Kong or Envoy of the self-hosting
# stack. Rendered by the installer: @ANON_KEY@ and @SERVICE_ROLE_KEY@ are the instance's keys, so
# the rendered file is readable by root only.
#
# Two listeners:
#   - 8000, the API, which the reverse proxy publishes: only Auth, REST and real time.
#   - 8001, Studio, on the local network only, behind basic authentication.

# The reverse proxy, and the application on this host, append the visitor's address to the
# forwarding header. Only the last entry — what the trusted hop actually saw — is believed, and it
# becomes the whole header passed on, so Auth keys its limits on the visitor and on nothing the
# visitor wrote.
set_real_ip_from 127.0.0.1;
set_real_ip_from ::1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive off;

# The keys the maps below compare against are JWTs of some 190 characters, longer than the buckets
# nginx sizes for map keys by default.
map_hash_bucket_size 512;

map $http_upgrade $splitrip_connection_upgrade {
    default upgrade;
    ''      close;
}

# A request to a protected route must carry one of the instance's keys, in the header or, as the
# real-time socket does, in the query string. Preflight requests carry neither and are let through.
map $http_apikey $splitrip_apikey_header {
    default             0;
    "@ANON_KEY@"         1;
    "@SERVICE_ROLE_KEY@" 1;
}

map $arg_apikey $splitrip_apikey_query {
    default             0;
    "@ANON_KEY@"         1;
    "@SERVICE_ROLE_KEY@" 1;
}

map "$request_method $splitrip_apikey_header$splitrip_apikey_query" $splitrip_apikey_ok {
    "~^OPTIONS " 1;
    "~ 00$"      0;
    default      1;
}

server {
    listen 8000;
    listen [::]:8000;
    server_name _;

    client_max_body_size 2m;

    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $http_host;

    # Auth's own links, opened from outside the application, carry no key.
    location ~ ^/auth/v1/(verify|callback|authorize|\.well-known/jwks\.json) {
        rewrite ^/auth/v1/(.*)$ /$1 break;
        proxy_set_header X-Forwarded-Prefix /auth/v1/;
        proxy_pass http://127.0.0.1:9999;
    }

    location /auth/v1/ {
        if ($splitrip_apikey_ok = 0) { return 401; }
        proxy_set_header X-Forwarded-Prefix /auth/v1/;
        proxy_pass http://127.0.0.1:9999/;
    }

    location /rest/v1/ {
        if ($splitrip_apikey_ok = 0) { return 401; }
        proxy_set_header X-Forwarded-Prefix /rest/v1/;
        proxy_pass http://127.0.0.1:3001/;
    }

    # Realtime administers its tenants through these; nobody outside needs them.
    location /realtime/v1/api/tenants { return 404; }
    location /realtime/v1/api/openapi { return 404; }

    # Realtime chooses the tenant from the host's first label; a self-hosted stack has one.
    location /realtime/v1/api {
        if ($splitrip_apikey_ok = 0) { return 401; }
        proxy_set_header Host realtime-dev.supabase-realtime;
        proxy_set_header X-Forwarded-Prefix /realtime/v1/api;
        proxy_pass http://127.0.0.1:4000/api;
    }

    location /realtime/v1/ {
        if ($splitrip_apikey_ok = 0) { return 401; }
        proxy_set_header Host realtime-dev.supabase-realtime;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $splitrip_connection_upgrade;
        proxy_set_header X-Forwarded-Prefix /realtime/v1/;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass http://127.0.0.1:4000/socket/;
    }

    # Studio, postgres-meta and everything else: not here.
    location / { return 404; }
}

server {
    listen 8001;
    listen [::]:8001;
    server_name _;

    auth_basic "Splitrip: Supabase Studio";
    auth_basic_user_file /etc/nginx/splitrip-studio.htpasswd;

    client_max_body_size 20m;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $splitrip_connection_upgrade;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 5m;
        proxy_pass http://127.0.0.1:3002;
    }
}
