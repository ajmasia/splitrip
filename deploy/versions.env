# Every component an instance runs, at the version it runs.
#
# The Supabase versions are taken together from one release of Supabase's self-hosting stack
# (docker/docker-compose.yml in github.com/supabase/supabase), so the combination is one upstream
# has tested. Moving to a newer stack means copying its versions here, with their checksums and
# digests; `update` installs whatever changed beside what is running and switches to it.
#
# Binaries are checked against the SHA-256 recorded beside them. Images are read by digest, never by
# tag; the tag only names the directory the component is installed in.

# Taken from the self-hosting stack as of 2026-09-07.
SUPABASE_STACK=2026.09.07

AUTH_VERSION=v2.196.0
AUTH_URL=https://github.com/supabase/auth/releases/download/v2.196.0/auth-v2.196.0-x86.tar.gz
AUTH_SHA256=69aa7b9e519f33f66455c057d622414c7e79c9b33e0907af622fd22cb303512d

POSTGREST_VERSION=v14.17
POSTGREST_URL=https://github.com/PostgREST/postgrest/releases/download/v14.17/postgrest-v14.17-linux-static-x86-64.tar.xz
POSTGREST_SHA256=d6e13926457487c99b77366d795dcfa32700554d08d418131d9a4ea3f6ca25e3

REALTIME_VERSION=v2.134.10
REALTIME_IMAGE=supabase/realtime@sha256:cbcc6a7986fc28b6dcffa798b077d5fb9c69cd25500371ab49147a86d7edbb03

META_VERSION=v0.99.0
META_IMAGE=supabase/postgres-meta@sha256:9a079ac1c94d89629262822a4bd1902d5b1be4adb464e5a0a8fd078aaed72158

STUDIO_VERSION=2026.09.07-sha-7996410
STUDIO_IMAGE=supabase/studio@sha256:94a2a9d2906e8b4109e55159a62e241c3044709a492913ea8edd34b14973d288

# The Node that Studio and postgres-meta are built for, used for the application too.
NODE_VERSION=v22.23.2
NODE_URL=https://nodejs.org/dist/v22.23.2/node-v22.23.2-linux-x64.tar.xz
NODE_SHA256=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307

# The same version the repository pins as a dev dependency, so production applies migrations exactly
# as development does.
SUPABASE_CLI_VERSION=v2.116.0
SUPABASE_CLI_URL=https://github.com/supabase/cli/releases/download/v2.116.0/supabase_2.116.0_linux_amd64.tar.gz
SUPABASE_CLI_SHA256=5b3031cb297d51b25be4c284e4c852254460ec722ec221d3b81b07d55acfd158

CRANE_VERSION=v0.22.1
CRANE_URL=https://github.com/google/go-containerregistry/releases/download/v0.22.1/go-containerregistry_Linux_x86_64.tar.gz
CRANE_SHA256=0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0
