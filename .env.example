# Local Supabase stack, started with `npm run db:start`.
#
# These are NOT secrets. The Supabase CLI generates the same values on every
# machine for the local stack, so they are committed to make a fresh clone work
# without setup. Production values are configured in Vercel and never live here.
#
# Copy this file to .env.local to get started:
#   cp .env.example .env.local

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
